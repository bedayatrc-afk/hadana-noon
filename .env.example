# انسخ هذا الملف إلى .env ثم عدّل القيم المناسبة لجهازك.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# اترك البريد فارغًا للتطوير المحلي؛ ستظهر الرسائل في طرفية Django.
# لإرسال البريد فعلًا، ضع Gmail App Password جديدًا هنا بعد تدويره.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
